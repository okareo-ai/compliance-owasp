{
    "_comment": "OWASP Compliance Suite — Shared Target Agent Configuration. Copy to owasp/target.json and fill in your values.",
    "_comment_a2a": "For A2A JSON-RPC targets, add \"contextId\": \"{session_id}\" under request_body.params.message and set session.session_id_path to \"response.result.contextId\".",

    "name": "my-agent",

    "endpoint_url": "https://your-agent.example.com/chat",
    "method": "POST",
    "max_parallel_requests": 1,

    "request_body": {"message": "{latest_message}"},
    "response_path": "response",

    "api_key": "",

    "auth": {
        "url": "",
        "method": "POST",
        "headers": {},
        "body": {},
        "response_access_token_path": "response.access_token"
    },

    "session": {
        "start_url": "",
        "session_id_path": "",
        "end_url": "",
        "end_body": {}
    }
}
