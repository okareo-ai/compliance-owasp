# OWASP Compliance Suite — Shared Target Agent Configuration
#
# Copy this file to owasp/target.env and fill in your values:
#   cp owasp/target.env.example owasp/target.env
#
# This file defines the single agent under test across ALL OWASP categories.
# Every category notebook loads from this file so that all controls evaluate
# the same agent. To retarget a different agent, edit only this file.
#
# The notebook uses the Okareo CustomEndpointTarget API:
#   https://docs.okareo.com/docs/simulation/introduction

# A human-readable name for the agent — used as the Okareo target registration name
TARGET_NAME=my-agent

# ── Next-Turn Endpoint (required) ────────────────────────────────────────────
# The HTTP endpoint that accepts a user message and returns the agent response.
TARGET_ENDPOINT_URL=https://your-agent.example.com/chat

# HTTP method (default: POST)
TARGET_METHOD=POST

# MAX PARALLEL REQUESTS: How many conversations can be held at one time
TARGET_MAX_PARALLEL_REQUESTS=1

# JSON request body template. Use {latest_message} for the user's message.
# Include {session_id} if your endpoint requires a session/thread identifier.
# Must be valid JSON. Examples:
#   {"message": "{latest_message}"}
#   {"message": "{latest_message}", "thread_id": "{session_id}"}
TARGET_REQUEST_BODY={"message": "{latest_message}"}

# JSONPath to the assistant's response text in the API response JSON.
# Examples:
#   "response"                       → for {"response": "Hello!"}
#   "response.assistant_response"    → for {"response": {"assistant_response": "Hello!"}}
#   "choices[0].message.content"     → for OpenAI-style responses
TARGET_RESPONSE_PATH=response

# ── Authentication (optional) ────────────────────────────────────────────────
# API key or token. Sent in request headers as configured below.
# Leave blank if the endpoint does not require authentication.
TARGET_API_KEY=

# ── Session Management (optional) ───────────────────────────────────────────
# If your agent requires explicit session creation/teardown, set these.
# Leave blank for stateless endpoints (most simple chat APIs).

# URL to create a new session before a conversation starts
TARGET_SESSION_START_URL=

# Path to the session ID in the start-session response JSON (e.g., "session_id")
TARGET_SESSION_ID_PATH=

# URL to end a session after a conversation completes
TARGET_SESSION_END_URL=

# JSON body to send when ending a session (e.g., {"session_id": "{session_id}"})
# Leave blank for endpoints that don't require a body on session end.
TARGET_SESSION_END_BODY=
