# Okareo OWASP Compliance Suite — Environment Configuration
#
# Copy this file to .env at the repository root:
#   cp owasp/config.env.example .env
#
# Then fill in your Okareo API key.
# Note: target agent configuration lives in owasp/target.env (see owasp/target.env.example).

OKAREO_API_KEY=your_okareo_api_key_here
